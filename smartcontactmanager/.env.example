# Copy to ".env" (which is git-ignored) and fill in YOUR values.
# Spring Boot does not read .env by itself: export these variables in your shell / IDE run configuration
# (see SETUP.md). Nothing in this file is a real secret.

# ---- Database (MySQL) ----
DB_URL=jdbc:mysql://localhost:3306/smartcontact?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=your_mysql_user
DB_PASSWORD=your_mysql_password

# ---- Email for password-reset codes (Gmail: use an App Password, never your normal password) ----
MAIL_USERNAME=your_address@gmail.com
MAIL_PASSWORD=your_16_character_app_password

# ---- Razorpay (rzp_test_... for testing, rzp_live_... only in production) ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Secret you choose when creating the webhook in the Razorpay Dashboard (optional but recommended)
RAZORPAY_WEBHOOK_SECRET=a_long_random_string

# ---- Optional ----
# Where uploaded photos are stored (default: ./user-photos). Back this folder up with your database.
UPLOAD_DIR=user-photos
# Long random string so "remember me" logins survive restarts (random per start if empty)
REMEMBER_ME_KEY=
